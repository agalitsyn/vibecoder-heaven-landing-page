---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import MobileNav from "./MobileNav.tsx";

interface Props {
  links?: Array<{ label: string; href: string }>;
  cta?: { label: string; href: string };
}

const {
  links = [
    { label: "Collection", href: "#collection" },
    { label: "About", href: "#about" },
    { label: "Support", href: "#support" },
  ],
  cta = { label: "Shop Now", href: "#collection" },
} = Astro.props;
---

<header class="fixed top-0 z-50 w-full bg-background/40 backdrop-blur-md">
  <nav class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="font-display text-2xl text-white tracking-wide">SUMMIT</a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-foreground/60 hover:text-foreground transition-colors tracking-wide font-body"
        >
          {link.label}
        </a>
      ))}
      <a
        href={cta.href}
        class={cn(
          buttonVariants({ size: "sm" }),
          "bg-primary text-primary-foreground hover:bg-primary/90 font-semibold text-sm px-5"
        )}
      >
        {cta.label}
      </a>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden">
      <MobileNav client:visible links={links} cta={cta} />
    </div>
  </nav>
</header>
