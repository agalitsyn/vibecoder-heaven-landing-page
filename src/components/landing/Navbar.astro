---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import MobileNav from "./MobileNav.tsx";

interface Props {
  logo?: string;
  links?: Array<{ label: string; href: string }>;
  cta?: { label: string; href: string };
}

const {
  logo = "Brand",
  links = [
    { label: "Features", href: "#features" },
    { label: "Pricing", href: "#pricing" },
    { label: "Testimonials", href: "#testimonials" },
  ],
  cta = { label: "Get Started", href: "#cta" },
} = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <nav class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="text-xl font-bold">{logo}</a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-6">
      {links.map((link) => (
        <a href={link.href} class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
          {link.label}
        </a>
      ))}
      <a href={cta.href} class={cn(buttonVariants({ variant: "default" }))}>
        {cta.label}
      </a>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden">
      <MobileNav client:visible links={links} cta={cta} />
    </div>
  </nav>
</header>
