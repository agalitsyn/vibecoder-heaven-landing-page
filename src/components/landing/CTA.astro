---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Props {
  headline?: string;
  subtext?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const {
  headline = "Ready to get started?",
  subtext = "Join thousands of satisfied customers today.",
  primaryCTA = { label: "Get Started", href: "#" },
  secondaryCTA,
} = Astro.props;
---

<section id="cta" class="border-t bg-muted/50">
  <div class="container mx-auto px-4 py-24 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{headline}</h2>
    <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">{subtext}</p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a href={primaryCTA.href} class={cn(buttonVariants({ size: "lg" }))}>
        {primaryCTA.label}
      </a>
      {secondaryCTA && (
        <a href={secondaryCTA.href} class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
          {secondaryCTA.label}
        </a>
      )}
    </div>
  </div>
</section>
